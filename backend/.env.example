ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Primary LLM Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TAU=0.58
TOP_K_CHUNKS=4
VECTOR_DB_TYPE=chroma # "chroma" or "pinecone"

# Optional: Pinecone Cloud Vector DB (when VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mutual-fund-facts
PINECONE_ENVIRONMENT=us-east-1

# Storage Paths
DATA_DIR=../data
FACTS_DB_PATH=../data/index/facts.db
CHROMA_DIR=../data/index/chroma
SESSION_TTL_DAYS=7
